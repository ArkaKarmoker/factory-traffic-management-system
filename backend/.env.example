# Django Configuration
SECRET_KEY=django-insecure-ftms-sample-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Configuration for Next.js Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Leave blank for default SQLite3)
# For PostgreSQL: postgresql://postgres:postgrespassword@localhost:5432/factory_traffic
DATABASE_URL=

# Traffic Timing Configuration (in seconds)
DEFAULT_GREEN_DURATION=30
DEFAULT_YELLOW_DURATION=5
DEFAULT_ALL_RED_DURATION=2

# Security & Admin Override Token
ADMIN_API_TOKEN=factory-admin-token-2026
AUTH_REQUIRED_FOR_COMMANDS=False
