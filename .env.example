# ==============================================================================
# Factory Traffic Management System (FTMS) - Root Environment Reference
# ==============================================================================

# Backend Service (.env or docker-compose)
BACKEND_SECRET_KEY=django-insecure-ftms-sample-secret-key-2026
BACKEND_DEBUG=True
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_API_TOKEN=factory-admin-token-2026
AUTH_REQUIRED_FOR_COMMANDS=False

# Database (Leave blank for default SQLite3, or configure PostgreSQL for Docker)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/factory_traffic

# Frontend Next.js Service
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEFAULT_ADMIN_TOKEN=factory-admin-token-2026
